rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pilot rules: any signed-in Google account can read and write the workspace.
    // Tighten per workspace/member before a wider rollout.
    match /workspaces/{workspaceId}/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
