rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }
    function memberPath(ws) {
      return /databases/$(database)/documents/workspaces/$(ws)/members/$(request.auth.uid);
    }
    function isMember(ws) {
      return signedIn() && exists(memberPath(ws));
    }
    // Same check for writes that land in the batch that creates the member record.
    function isMemberAfter(ws) {
      return signedIn() && existsAfter(memberPath(ws));
    }
    function canManage(ws) {
      return isMember(ws) && get(memberPath(ws)).data.role in ['owner', 'admin'];
    }
    function tokenEmail() {
      return ('email' in request.auth.token) ? string(request.auth.token.email).lower() : '';
    }
    function invite(id) {
      return get(/databases/$(database)/documents/invites/$(id)).data;
    }
    // True after an emailed sign-in link or the one-time sign-up code.
    function verifiedEmail() {
      return request.auth.token.email_verified == true;
    }

    // Each account reads and writes only its own profile (workspaces it belongs to).
    match /users/{userId} {
      allow read, write: if signedIn() && uid() == userId;
    }

    match /workspaces/{ws} {
      // The workspace document: created by the server once a subscription pays for it, readable by members, renamed by managers.
      allow read: if isMember(ws);
      allow create: if false;
      allow update: if canManage(ws);
      allow delete: if false;

      match /members/{memberId} {
        allow read: if isMember(ws);
        // Your own record appears when you redeem a pending invite addressed to your verified email; the server writes the owner's; managers add others.
        allow create: if canManage(ws)
          || (signedIn() && memberId == uid()
              && request.resource.data.inviteId is string
              && invite(request.resource.data.inviteId).workspaceId == ws
              && invite(request.resource.data.inviteId).status == 'pending'
              && invite(request.resource.data.inviteId).role == request.resource.data.role
              && (!('email' in invite(request.resource.data.inviteId)) || (invite(request.resource.data.inviteId).email == tokenEmail() && verifiedEmail())));
        // Presence and profile details on your own record; roles and removal are for managers.
        allow update: if canManage(ws)
          || (signedIn() && memberId == uid() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeenAt', 'status', 'name', 'color', 'email']));
        allow delete: if canManage(ws) || (signedIn() && memberId == uid());
      }

      // Connection secrets (API tokens) are written and read by the server only.
      match /secrets/{docId} {
        allow read, write: if false;
      }

      // Everything else in a workspace is shared by its members.
      match /{collection}/{docId} {
        allow read: if collection != 'members' && collection != 'secrets' && isMember(ws);
        allow write: if collection != 'members' && collection != 'secrets' && isMemberAfter(ws);
      }
    }

    // One-time sign-up codes, subscription records and in-flight OAuth states are handled by the server only.
    match /emailCodes/{userId} {
      allow read, write: if false;
    }
    match /oauthStates/{state} {
      allow read, write: if false;
    }
    match /feedback/{noteId} {
      allow read, write: if false;
    }
    match /adminActions/{actionId} {
      allow read, write: if false;
    }
    match /eventShares/{slug} {
      allow read, write: if false;
    }
    match /subscriptions/{subscriptionId} {
      allow read, write: if false;
    }

    match /invites/{code} {
      // Ids are unguessable: the join page shows who invited whom before sign-in.
      allow get: if true;
      // Listing is limited to your own email or to workspaces you manage.
      allow list: if signedIn() && (('email' in resource.data && resource.data.email == tokenEmail()) || canManage(resource.data.workspaceId));
      allow create: if signedIn() && request.resource.data.id == code && request.resource.data.status == 'pending' && canManage(request.resource.data.workspaceId);
      allow update: if signedIn() && (
        canManage(resource.data.workspaceId)
        || (resource.data.status == 'pending'
            && request.resource.data.status == 'accepted'
            && request.resource.data.acceptedById == uid()
            && (!('email' in resource.data) || (resource.data.email == tokenEmail() && verifiedEmail()))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedById', 'acceptedByName', 'acceptedAt']))
      );
      allow delete: if signedIn() && canManage(resource.data.workspaceId);
    }
  }
}
