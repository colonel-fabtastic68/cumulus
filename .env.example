# cumulusOS environment. Copy to .env.local for local development; add the same
# names in Vercel (Project → Settings → Environment Variables) for deployments.
# None of these need a NEXT_PUBLIC_ prefix: the server reads them at request
# time and hands the Firebase config to the browser itself.

# --- AI (required for the agent) -------------------------------------------
# Get a key at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional: override the model (defaults to gemini-3.8-flash)
# GEMINI_MODEL=gemini-flash-latest
# Optional: models tried in order when the primary is overloaded (503) or rate-limited
# GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.6-flash
# Optional: seconds a model may take to start answering before the next one is tried (ms, default 15000)
# GEMINI_CONNECT_TIMEOUT_MS=15000

# --- Server access to the live workspace (MCP endpoint) ---------------------
# Firebase console → Project settings → Service accounts → Generate new private key.
# Paste the downloaded JSON on one line (or base64 it into FIREBASE_SERVICE_ACCOUNT_B64).
# With this set, POST /api/mcp reads and writes the real workspace; without it,
# the endpoint serves an in-memory demo.
FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_SERVICE_ACCOUNT_B64=

# --- MCP endpoint (optional) -------------------------------------------------
# When set, POST /api/mcp requires "Authorization: Bearer <token>". Leave blank
# to keep the demo-dataset endpoint open. Generate one from Strato → Connect other agents.
CUMULUS_MCP_TOKEN=

# --- Database (optional) ----------------------------------------------------
# Leave blank to run in local mode (data in the browser's localStorage).
# Values come from Firebase console → Project settings → Your apps → Web app
# (paste the bare values, no quotes or commas).
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
# Workspace document id under /workspaces (one per company)
# Workspace served by the MCP endpoint, and the pre-account workspace whose members are carried over into their profiles.
CUMULUS_WORKSPACE=default

# ---- Live connections (Shopify, WooCommerce, Shippo, EasyPost) ----
# Public URL of this deployment, used when registering webhooks with the platforms.
# Leave empty to use the request's own origin (fine on Vercel).
APP_URL=
# Shared secret Vercel sends with the scheduled reconciliation call (vercel.json → crons).
# Generate one with: openssl rand -hex 24
CRON_SECRET=

# ---- Billing (Stripe, optional) ----
# Creating a workspace at /workspaces/new asks for this subscription through Stripe Checkout once both are set.
# Create the $99/month recurring price in the Stripe dashboard and paste its id (price_…).
STRIPE_SECRET_KEY=
STRIPE_PRICE_FOUNDING=
# Signing secret for POST /api/billing/webhook (Stripe dashboard → Developers → Webhooks). Keeps renewals and cancellations in sync.
STRIPE_WEBHOOK_SECRET=
# Addresses (comma separated) that may create workspaces without paying, such as your own and pilot customers. Only verified emails count.
BILLING_EXEMPT_EMAILS=

# ---- One-time email codes for new sign-ups (Resend, optional) ----
# Install Resend from the Vercel Marketplace (vercel integration add resend/resend-email) or use a key from resend.com.
# EMAIL_FROM must be on a domain verified in Resend, e.g. "cumulusOS <codes@yourdomain.com>". Without both, sign-ups skip the code.
RESEND_API_KEY=
EMAIL_FROM=

# ---- Demo booking (Calendly, optional) ----
# The scheduling link the "Book a demo" page embeds, e.g. https://calendly.com/yourname/30min
# Without it the page invites people to create an account instead.
CALENDLY_URL=
